# Copy to .env. Host-side tools (uv run ...) reach Postgres on localhost:5434;
# the compose api service overrides DATABASE_URL to use db:5432.
DATABASE_URL=postgresql+asyncpg://tf:tf@localhost:5434/tesseract_finance
STORAGE_BACKEND=local
STORAGE_DIR=/data/receipts
MAX_UPLOAD_MB=10
JWT_SECRET=
JWT_TTL_MINUTES=60
DEV_USER_EMAIL=dev@example.com
